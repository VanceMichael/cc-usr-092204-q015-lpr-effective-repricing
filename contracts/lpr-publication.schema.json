{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LPR报价与勘误消息",
  "type": "object",
  "required": [
    "id",
    "variety",
    "rateBp",
    "publishDate",
    "effectiveFrom",
    "source",
    "approvedBy"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "报价唯一标识"
    },
    "variety": {
      "enum": [
        "1Y",
        "5Y_PLUS"
      ],
      "description": "期限品种：一年期 / 五年期以上"
    },
    "rateBp": {
      "type": "integer",
      "minimum": 1,
      "description": "报价利率（基点）"
    },
    "publishDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "发布日期（档案信息，不参与有效性判定）"
    },
    "effectiveFrom": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "生效起始日（含），引用一律按有效区间判定"
    },
    "source": {
      "type": "string",
      "description": "授权发布来源"
    },
    "approvedBy": {
      "type": "string",
      "description": "登记批准人"
    },
    "corrects": {
      "type": "string",
      "description": "勘误对象报价标识；存在即本条为勘误记录"
    },
    "reason": {
      "type": "string",
      "description": "勘误原因"
    },
    "note": {
      "type": "string",
      "description": "备注"
    }
  },
  "additionalProperties": false
}
